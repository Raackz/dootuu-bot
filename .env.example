# Control bot from @BotFather
BOT_TOKEN=
# or
# MAILER_BOT_TOKEN=

# true = любой, кто открыл бота, может добавлять аккаунты (для команды)
MAILER_OPEN=false

# Admin Telegram numeric IDs (comma-separated) — optional if MAILER_OPEN=false
ADMIN_IDS=
# or usernames without @
ADMIN_USERNAMES=raackz

# https://my.telegram.org → API development tools (for mailing accounts)
# Нужны ОДИН раз на весь бот — не ключ с LZT
TG_API_ID=
TG_API_HASH=

# Optional defaults
# MAILER_CYCLE_LIMIT=50
# MAILER_CYCLE_PAUSE_SEC=3600
# MAILER_DELAY_SEC=8
