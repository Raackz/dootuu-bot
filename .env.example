# Control bot from @BotFather
BOT_TOKEN=
# or
# MAILER_BOT_TOKEN=

# Admin Telegram numeric IDs (comma-separated) — @userinfobot
ADMIN_IDS=
# or usernames without @
ADMIN_USERNAMES=

# https://my.telegram.org → API development tools (for mailing accounts)
TG_API_ID=
TG_API_HASH=

# Optional defaults
# MAILER_CYCLE_LIMIT=50
# MAILER_CYCLE_PAUSE_SEC=3600
# MAILER_DELAY_SEC=8
